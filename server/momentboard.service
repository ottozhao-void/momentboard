[Unit]
Description=Momentboard — static site + persistence API
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/tsg-leaderboard
Environment=PORT=8080
ExecStart=/home/ubuntu/.nvm/versions/node/v22.22.1/bin/node /home/ubuntu/tsg-leaderboard/server/server.js
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=default.target
